	partition HandoverFact = m
		mode: directQuery
		source =
				let
				    Source = PostgreSQL.Database("<project-ref>.pooler.supabase.com:5432", "postgres"),
				    Nav = Source{[Schema="reporting",Item="handover_fact"]}[Data]
				in
				    Nav

