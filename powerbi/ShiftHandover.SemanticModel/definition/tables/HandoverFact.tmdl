/// Fakta utama handover, satu baris per handover.
table HandoverFact
	lineageTag: e56452ca-d561-4ad3-a544-425a1afa67de

	/// Jumlah handover.
	measure 'Total Handover' = COUNTROWS(HandoverFact)
		formatString: #,##0
		lineageTag: 43f6b039-7512-46b5-b0b0-24afb023ff34

	/// Jumlah handover berstatus draft.
	measure 'Handover Draft' = CALCULATE([Total Handover], HandoverFact[is_draft] = TRUE())
		formatString: #,##0
		lineageTag: 36d8c2f6-6eee-4975-a601-dcf678967fd0

	/// Jumlah handover submitted.
	measure 'Handover Submitted' = CALCULATE([Total Handover], HandoverFact[is_submitted] = TRUE())
		formatString: #,##0
		lineageTag: 18248696-38d2-40ce-a1d7-b4f3ff7cbbe3

	/// Jumlah handover approved.
	measure 'Handover Approved' = CALCULATE([Total Handover], HandoverFact[is_approved] = TRUE())
		formatString: #,##0
		lineageTag: 26de84cd-0319-407a-a60f-7d3e9d22cc2f

	/// Jumlah handover rejected.
	measure 'Handover Rejected' = CALCULATE([Total Handover], HandoverFact[is_rejected] = TRUE())
		formatString: #,##0
		lineageTag: c6e1e968-aea7-4824-af34-566d37b65281

	/// Jumlah handover reopened.
	measure 'Handover Reopened' = CALCULATE([Total Handover], HandoverFact[is_reopened] = TRUE())
		formatString: #,##0
		lineageTag: 47a2ecce-c8fe-487a-968e-6489282154af

	/// Handover yang masih pending.
	measure 'Handover Pending' = CALCULATE([Total Handover], HandoverFact[is_pending] = TRUE())
		formatString: #,##0
		lineageTag: 8c121db5-db67-465c-a066-66d679bd43e7

	/// Persentase handover approved.
	measure 'Approval Rate' = DIVIDE([Handover Approved], [Total Handover])
		formatString: 0.0%
		lineageTag: c72190db-0c60-4e8c-afc8-4d5793749aff

	/// Persentase handover rejected.
	measure 'Rejection Rate' = DIVIDE([Handover Rejected], [Total Handover])
		formatString: 0.0%
		lineageTag: 71739458-654d-42e6-b62d-bdcb2528d25a

	/// Persentase handover pending.
	measure 'Pending Rate' = DIVIDE([Handover Pending], [Total Handover])
		formatString: 0.0%
		lineageTag: 7893af15-20c3-4d83-a29b-73b41a38b8d3

	/// Handover yang mencatat kendala.
	measure 'Handover with Kendala' = CALCULATE([Total Handover], HandoverFact[has_kendala] = TRUE())
		formatString: #,##0
		lineageTag: a721f7e0-76d8-431b-a431-ebd8f732d377

	/// Handover yang mencatat safety issue.
	measure 'Handover with Safety Issue' = CALCULATE([Total Handover], HandoverFact[has_safety_issue] = TRUE())
		formatString: #,##0
		lineageTag: 9cec7139-e034-4e21-917c-486d54bb6971

	/// Handover yang memiliki catatan.
	measure 'Handover with Catatan' = CALCULATE([Total Handover], HandoverFact[has_catatan] = TRUE())
		formatString: #,##0
		lineageTag: 330747b3-caf1-49a6-8560-5bf94b00dcdc

	/// Rata-rata skor kelengkapan data handover.
	measure 'Data Completeness' = AVERAGE(HandoverFact[data_completeness_score])
		formatString: 0.0%
		lineageTag: 9d208698-98e8-4de4-b8d3-cc889284e358

	/// Tanggal handover terakhir.
	measure 'Latest Handover Date' = MAX(HandoverFact[tanggal_operasional])
		formatString: dd/mm/yyyy
		lineageTag: 34f7568e-12e0-4275-80e3-8f36827e2b8c

	/// Handover month-to-date.
	measure 'Handover MTD' = TOTALMTD([Total Handover], DimDate[date])
		formatString: #,##0
		lineageTag: 730adf5a-cecf-4e18-87a9-a0ffc493f638

	/// Handover year-to-date.
	measure 'Handover YTD' = TOTALYTD([Total Handover], DimDate[date])
		formatString: #,##0
		lineageTag: d6bdb9dd-3549-4810-b189-28fc7224f995

	/// Handover bulan sebelumnya.
	measure 'Handover Previous Month' = CALCULATE([Total Handover], PREVIOUSMONTH(DimDate[date]))
		formatString: #,##0
		lineageTag: aa471a3a-2d34-40ec-a2b7-09ded1f895e4

	/// Perubahan handover month-over-month.
	measure 'Handover MoM %' = DIVIDE([Total Handover] - [Handover Previous Month], [Handover Previous Month])
		formatString: 0.0%
		lineageTag: d4048353-543b-46f9-836d-975be3647119

	/// Jumlah baris aktivitas.
	measure 'Total Aktivitas' = COUNTROWS(ActivityFact)
		formatString: #,##0
		lineageTag: 61e9c10a-99f1-4014-ac0e-f777da6077d8

	/// Jumlah baris approval.
	measure 'Total Approval' = COUNTROWS(ApprovalFact)
		formatString: #,##0
		lineageTag: be008e87-1c8e-49a7-870c-b1f0afc7f97f

	/// Rata-rata waktu keputusan approval dalam menit.
	measure 'Rata-rata Waktu Approval (menit)' = AVERAGE(ApprovalFact[decision_minutes])
		formatString: #,##0.0
		lineageTag: 093aae0e-b2c4-403a-a38c-764277d46249

	/// Median waktu keputusan approval dalam menit.
	measure 'Median Waktu Approval (menit)' = MEDIAN(ApprovalFact[decision_minutes])
		formatString: #,##0.0
		lineageTag: d2ad3011-c427-45ea-8c5e-4bfc70b84a41

	/// Rata-rata jeda submit handover dalam menit.
	measure 'Rata-rata Waktu Submit (menit)' = AVERAGE(HandoverFact[submission_delay_minutes])
		formatString: #,##0.0
		lineageTag: 7b6515c5-5e2b-4a11-b855-f74fc314f50a

	/// Jumlah outstanding job.
	measure 'Total Outstanding Job' = COUNTROWS(OutstandingJobFact)
		formatString: #,##0
		lineageTag: 53d15d47-0e65-4c5d-9830-f56fbad4b1e5

	/// Outstanding job yang masih open.
	measure 'Open Job' = CALCULATE([Total Outstanding Job], OutstandingJobFact[is_open] = TRUE())
		formatString: #,##0
		lineageTag: 41d89522-7c9e-4b2d-ad5a-f5c09ceb566b

	/// Outstanding job yang overdue.
	measure 'Overdue Job' = CALCULATE([Total Outstanding Job], OutstandingJobFact[is_overdue] = TRUE())
		formatString: #,##0
		lineageTag: dbcb4e10-626f-4fff-bcd6-e6752646cec5

	/// Jumlah baris critical equipment.
	measure 'Total Critical Equipment' = COUNTROWS(CriticalEquipmentFact)
		formatString: #,##0
		lineageTag: 4a718d86-fa0a-4277-a1d6-8d0278a3240a

	/// Critical equipment dengan issue.
	measure 'Critical Equipment Issue' = CALCULATE([Total Critical Equipment], CriticalEquipmentFact[is_issue] = TRUE())
		formatString: #,##0
		lineageTag: ecda2ab9-c4aa-462b-9c87-d44c4284cc09

	/// Persentase critical equipment bermasalah.
	measure 'Critical Equipment Issue Rate' = DIVIDE([Critical Equipment Issue], [Total Critical Equipment])
		formatString: 0.0%
		lineageTag: 529da530-67f3-4492-957d-682b3bdf7810

	/// Jumlah baris safety tool.
	measure 'Total Safety Tool' = COUNTROWS(SafetyToolFact)
		formatString: #,##0
		lineageTag: 255355e0-651e-45e7-9bcf-cba22f8f5cbf

	/// Safety tool dengan issue.
	measure 'Safety Tool Issue' = CALCULATE([Total Safety Tool], SafetyToolFact[is_issue] = TRUE())
		formatString: #,##0
		lineageTag: 0e258e54-060a-4c1c-bb46-a9b31492f46b

	/// Persentase safety tool bermasalah.
	measure 'Safety Tool Issue Rate' = DIVIDE([Safety Tool Issue], [Total Safety Tool])
		formatString: 0.0%
		lineageTag: 7335a83f-d56e-4856-9df1-77f709c7a325

	/// Jumlah baris level tank dengan nomor tank valid.
	measure 'Total Tank Level' = CALCULATE(COUNTROWS(TankLevelFact), TankLevelFact[no_tanki_normalized] <> BLANK())
		formatString: #,##0
		lineageTag: ff548c07-eeae-444f-8231-a5a64a12d5a7

	/// Rata-rata level tank dalam mm, hanya tank valid.
	measure 'Rata-rata Level Tank (mm)' = CALCULATE(AVERAGE(TankLevelFact[level_mm]), TankLevelFact[no_tanki_normalized] <> BLANK())
		formatString: #,##0.0
		lineageTag: 2f7d38f7-72c6-4dec-9d3d-0f6ec0400ae6

	/// Rata-rata water content dalam mm, hanya tank valid.
	measure 'Rata-rata Water Content (mm)' = CALCULATE(AVERAGE(TankLevelFact[water_mm]), TankLevelFact[no_tanki_normalized] <> BLANK())
		formatString: #,##0.0
		lineageTag: 176a613b-8c5c-497d-9e71-30236572a216

	/// Jumlah baris QC.
	measure 'Total QC' = COUNTROWS(QCFact)
		formatString: #,##0
		lineageTag: d9e3c93a-6fbc-4392-aa7a-dab21cc74821

	/// Rata-rata density QC.
	measure 'Rata-rata Density' = AVERAGE(QCFact[density])
		formatString: #,##0.00
		lineageTag: dbde7e46-7801-4e63-b439-b9641d6db016

	/// Rata-rata temperatur QC.
	measure 'Rata-rata Temperatur' = AVERAGE(QCFact[temperatur_c])
		formatString: #,##0.0
		lineageTag: 2f11e60f-fb13-4d65-bbf0-25931a7730b6

	/// Jumlah permintaan transfer.
	measure 'Total Transfer Request' = COUNTROWS(TransferRequestFact)
		formatString: #,##0
		lineageTag: 1c44e901-b634-4837-a692-324e1ab8a249

	/// Total estimasi volume transfer dalam KL.
	measure 'Total Estimasi Transfer (KL)' = SUM(TransferRequestFact[est_jumlah_kl])
		formatString: #,##0.0
		lineageTag: f96e128c-6982-4b8d-9829-8f396cd7542c

